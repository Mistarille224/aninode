# Host-side Compose wiring. Credentials never belong here.
CONFIG_ROOT=./config
MEDIA_ROOT=/path/to/media
PUID=911
PGID=911
UMASK=022
ANINODE_BIND=127.0.0.1
ANINODE_PORT=7391
ANINODE_IMAGE=ghcr.io/mistarille224/aninode:latest

# Runtime daemon policy. This remains effective on every container start.
ANINODE_INTERVAL=15m

# First-run defaults only. They initialize /config/organizer.json when it does
# not exist. After initialization, edit these values through the WebUI/config;
# changing the environment does not overwrite persistent configuration.
ANINODE_INIT_SOURCE=/media/downloads
ANINODE_INIT_TARGET=/media/library
ANINODE_INIT_EXTENSIONS=.mkv,.mp4,.avi,.mov,.m4v,.ts,.webm
